# Semantic Scholar (optional key — increases rate limits; MVP works without one but may be throttled)
SEMANTIC_SCHOLAR_API_KEY=

# AI provider — MVP is wired for Gemini via the OpenAI-compatible abstraction in src/lib/ai.ts
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# Postgres connection string, e.g. postgresql://user:password@localhost:5432/orbiis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbiis

PORT=8787
